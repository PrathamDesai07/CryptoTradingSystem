# Application
APP_ENVIRONMENT=development

# Binance Spot Demo Mode credentials (never add real credentials to this file)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Fernet master key that encrypts stored user credentials. Generate one with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# When unset, a key file is generated next to the database (db/.master_key).
CREDENTIALS_MASTER_KEY=

# Optional overrides can use any uppercase config.yaml key, for example:
# APP_PORT=9000
# LOG_LEVEL=DEBUG
# TRADING_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
MAX_ORDER_BALANCE_UTILIZATION_PERCENT=80
DATABASE_PASSWORD=
